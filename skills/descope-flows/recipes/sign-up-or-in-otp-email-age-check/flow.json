      "32": {
        "id": "32",
        "name": "Scriptlet",
        "type": "automated",
        "action": "scriptlet",
        "arguments": {
          "outputPath": {
            "type": "inline",
            "value": "age"
          },
          "overrideForm": {
            "type": "inline",
            "value": ""
          },
          "scriptArgs": {
            "type": "inline",
            "value": [
              {
                "key": "dob",
                "type": "context",
                "value": "form.dateOfBirth"
              }
            ]
          },
          "scriptCode": {
            "type": "inline",
            "value": "// dob: epoch milliseconds of the chosen day at UTC midnight (DateInput with utc-time).\n// Inputs are null when their context key is missing: anything but a number counts as not eligible.\nconst MIN_AGE = 18;\nconst valid = typeof dob === \"number\" || (typeof dob === \"string\" && /^-?[0-9]+$/.test(dob));\nif (!valid) {\n  return { \"eligible\": false, \"valid\": false };\n}\nconst born = new Date(Number(dob));\nconst now = new Date();\nlet age = now.getUTCFullYear() - born.getUTCFullYear();\nconst months = now.getUTCMonth() - born.getUTCMonth();\nif (months < 0 || (months === 0 && now.getUTCDate() < born.getUTCDate())) {\n  age--;\n}\nreturn { \"eligible\": age >= MIN_AGE && age < 130, \"valid\": true, \"age\": age };"
          }
        },
        "errorHandlingV2": {
          "ScriptletFailed": {
            "errorHandlingType": "custom"
          }
        },
        "next": {
          "rules": [
            {
              "interactionId": "success",
              "taskId": "33"
            },
            {
              "interactionId": "ScriptletFailed",
              "taskId": "35"
            }
          ]
        },
